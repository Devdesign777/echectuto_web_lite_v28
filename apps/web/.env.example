# Public browser-safe Supabase values only. Never commit service_role secrets.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Required for password-reset redirect emails. Without this, reset links point to localhost.
NEXT_PUBLIC_SITE_URL=https://YOUR_DOMAIN.com
